{
  "functions": {
    "api/projects.ts": {
      "maxDuration": 30
    },
    "api/projects/[...path].ts": {
      "maxDuration": 30
    },
    "api/projects/[projectId]/docs/[kind].ts": {
      "maxDuration": 30
    },
    "api/projects/[projectId]/gis-drafts.ts": {
      "maxDuration": 30
    },
    "api/projects/[projectId]/gis-drafts/[draftId].ts": {
      "maxDuration": 30
    },
    "api/[...path].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install"
}
